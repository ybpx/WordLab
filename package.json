{
  "name": "wordlab",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "start": "node scripts/start.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "build:dict": "node scripts/build-dict.mjs",
    "test:version": "node scripts/test-node-version.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:v11": "node scripts/e2e-v11.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
